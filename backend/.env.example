
# ---------- LLM  ----------
LLM_API_KEY=sk-đổi-tôi
LLM_BASE_URL=https://api.openai.com/v1
# Model dùng để SINH SQL (tác vụ nhạy độ chính xác)
LLM_MODEL=gpt-4o
# Model rẻ hơn cho diễn giải báo cáo hàng đêm (mặc định = LLM_MODEL nếu bỏ trống)
LLM_MODEL_NARRATOR=

# ---------- Database (SQLAlchemy — Postgres target) ----------
# Dựng Postgres nhanh bằng docker:
#   docker run -d --name fs-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=feature_store -p 5432:5432 postgres:16
# Thứ tự khởi tạo (từ thư mục backend/):
#   1. alembic upgrade head                  # tạo schema (Alembic quản)
#   2. python -m scripts.generate_mock_data  # seed dữ liệu mock (idempotent)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/feature_store

# ---------- SQL guards (bắt buộc, enforce dưới prompt) ----------
# Giới hạn số dòng cứng cho mọi truy vấn.
SQL_MAX_ROWS=1000
# Default row limit and timeout for every read query.
SQL_DEFAULT_ROWS=100
SQL_TIMEOUT_MS=5000
# Danh sách cột nhạy cảm bị chặn ở tầng thực thi (phân tách bằng dấu phẩy).
SQL_SENSITIVE_COLUMNS=customer_name,phone,phone_number,email,national_id,cccd,address,dob,full_name
# Số lần tự sửa tối đa khi SQL lỗi.
SQL_MAX_REPAIRS=2

# ---------- Retrieval ----------
# Số feature tối đa đưa vào prompt sinh SQL.
RETRIEVAL_TOP_K=25

# ---------- App ----------
# Đường dẫn file semantic layer đã sinh.
SEMANTIC_LAYER_PATH=./data/semantic_layer.yaml
# CORS cho frontend dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
